# Copia questo file in .env e inserisci la chiave reale.
# Non committare mai il file .env.

# Necessaria SOLO se usi il provider anthropic per uno dei due ruoli.
ANTHROPIC_API_KEY=your_api_key_here

# Necessaria per il provider gemini — usato di default su Render (vedi
# render.yaml e README.md "Provider hosted consigliato per il deploy").
# Crea una chiave gratuita in Google AI Studio (nessuna carta richiesta).
# gemini-3.5-flash (il default, non "-pro": rimosso dal free tier) ha 15
# richieste/min, 1.500 richieste/giorno, ~250K token/min — niente tetto
# giornaliero sui token come Groq sotto.
GEMINI_API_KEY=

# Necessaria SOLO se usi il provider azure. E' la "API key" mostrata nella
# pagina della risorsa Azure AI Foundry (stesso valore usato sia per il
# "Project endpoint" che per l'"Azure OpenAI endpoint" — qui usiamo
# quest'ultimo).
AZURE_OPENAI_API_KEY=

# Necessaria SOLO se usi il provider groq (alternativa a gemini, non più il
# default di render.yaml — in uso reale ha colpito il suo tetto di 200.000
# TOKEN AL GIORNO per openai/gpt-oss-120b, un limite duro non aggirabile
# con retry; vedi README.md "Provider hosted alternativo: Groq"). Crea una
# chiave su console.groq.com (free tier, nessuna carta richiesta).
GROQ_API_KEY=

# Opzionale ma raccomandata: scoperta fonti via Tavily (pensato per agenti AI,
# free tier 1.000 ricerche/mese, senza carta di credito) invece dello scraping
# di backend di metasearch generici. Se lasciata vuota, web_search_ddg
# continua a funzionare tramite ddgs (nessuna chiave richiesta).
# Crea una chiave su tavily.com.
TAVILY_API_KEY=

# Nota: il provider effettivo di ricerca/sintesi e' impostato in
# .env.development (RESEARCH_AGENT_PROVIDER / SYNTHESIS_AGENT_PROVIDER), non
# qui. "ollama" non richiede nessuna chiave in questo file — solo installare
# Ollama e scaricare il modello, vedi README.md "Provider locale open-weight:
# Ollama + Qwen".

# --- Storage persistente dei report (opzionale in locale, necessaria in produzione) ---
# Se lasciate vuote, l'app funziona come prima: nessuna persistenza cloud,
# history solo nel browser. Vedi README.md "Deploy: prodotto per il team" e
# supabase/schema.sql. Usa la SERVICE ROLE key del progetto Supabase, non la
# "anon" key: viene usata solo lato backend, mai esposta al frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Accesso alla UI (opzionale in locale, raccomandata in produzione) ---
# Se lasciate vuote, l'app resta aperta senza login (comportamento locale
# invariato). Impostale entrambe prima di condividere l'URL con altri.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
