# Copia questo file in .env e inserisci la chiave reale.
# Non committare mai il file .env.

ANTHROPIC_API_KEY=your_api_key_here

# Necessaria SOLO se PROVIDER=gemini. Crea una chiave in Google AI Studio.
GEMINI_API_KEY=

# Opzionale: Gemma usa la stessa Gemini API e può riutilizzare
# GEMINI_API_KEY. Imposta questa variabile solo per usare una chiave separata.
GEMMA_API_KEY=

# Necessaria SOLO se PROVIDER=groq. Crea una chiave su GroqCloud.
GROQ_API_KEY=

# Necessaria SOLO se PROVIDER=mistral. Crea una chiave su La Plateforme
# (console.mistral.ai).
MISTRAL_API_KEY=

# Necessaria SOLO se PROVIDER=azure. E' la "API key" mostrata nella pagina
# della risorsa Azure AI Foundry (stesso valore usato sia per il "Project
# endpoint" che per l'"Azure OpenAI endpoint" — qui usiamo quest'ultimo).
AZURE_OPENAI_API_KEY=

# Opzionale ma raccomandata: scoperta fonti via Tavily (pensato per agenti AI,
# free tier 1.000 ricerche/mese, senza carta di credito) invece dello scraping
# di backend di metasearch generici (ddgs). Se lasciata vuota, web_search_ddg
# continua a funzionare tramite ddgs (nessuna chiave richiesta).
# Crea una chiave su tavily.com.
TAVILY_API_KEY=

# --- Storage persistente dei report (opzionale in locale, necessaria in produzione) ---
# Se lasciate vuote, l'app funziona come prima: nessuna persistenza cloud,
# history solo nel browser. Vedi README.md "Deploy su Render" e
# supabase/schema.sql. Usa la SERVICE ROLE key del progetto Supabase, non la
# "anon" key: viene usata solo lato backend, mai esposta al frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Accesso alla UI (opzionale in locale, raccomandata in produzione) ---
# Se lasciate vuote, l'app resta aperta senza login (comportamento locale
# invariato). Impostale entrambe prima di condividere l'URL con altri.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
