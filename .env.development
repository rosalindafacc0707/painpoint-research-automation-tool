MODEL_NAME=claude-sonnet-5
PROMPT_VERSION=v8
MAX_TOKENS=12000

# Used only when a role's provider is gemini. GEMINI_API_KEY (secret) lives
# in .env. gemini-2.5-pro was removed from the free tier in April 2026
# (paid-only now) — gemini-3.5-flash is the free-tier default: 15 RPM, 1500
# RPD, ~250K TPM. Verified live to follow the research prompt's fetch_url
# discipline correctly, unlike the "-lite" variants (gemini-3.5-flash-lite,
# gemini-3.1-flash-lite — both tested live 2026-08-18): faster/higher RPM,
# but both answered from web_search snippets alone, never calling fetch_url
# before citing a source — a real evidence-discipline violation, not a
# one-off. Stick to the non-lite model despite the lower RPM.
GEMINI_MODEL=gemini-3.1-flash-lite
#gemini-3.7-flash
#gemini-3.1-flash-lite

# Used only when a role's provider is ollama. No API key is needed: Ollama
# runs locally, so there is no external rate limit to hit no matter how many
# of the 8 research agents call it at once — they just queue locally instead
# of failing. qwen3.5:9b is the recommended local model for this 16 GB
# MacBook Air: it supports tool calling (required for the web_search/fetch_url
# MCP tools), unlike reasoning-only models such as deepseek-r1.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
#qwen3.5:9b
OLLAMA_NUM_CTX=32768
OLLAMA_TEMPERATURE=0.2
# qwen3.5 is a hybrid reasoning model — by default it emits a hidden
# chain-of-thought before every reply, measured at ~17 tok/s on this machine
# (a one-line "hello" turned into 1000+ reasoning tokens and 60+ seconds).
# OLLAMA_THINK=false (the default) skips that via Ollama's native think
# switch, cutting the same request to ~1s with no loss of tool-calling
# accuracy (verified locally). Set to true only if a role's output quality
# needs the extra reasoning and the slowdown is acceptable for that role.
OLLAMA_THINK=false

# Used only when a role's provider is groq. GROQ_API_KEY (secret) lives in
# .env. openai/gpt-oss-120b on Groq's LPU hardware — much faster than local
# ollama, free tier, no payment method, and (verified live) reliable tool
# calling — unlike llama-3.3-70b-versatile, which intermittently emits a
# malformed pythonic tag instead of a real tool call and is best reserved
# for the synthesis role (no tools) if used at all; see the module
# docstring in providers/groq_provider.py for the full writeup.
# GROQ_TPM_LIMIT=8000 matches the allowance actually observed on this
# account; raise it if your tier allows more. GROQ_RPM_LIMIT paces every
# request from this process so 8 concurrent research agents don't all blow
# the free tier's ~30 RPM cap by firing in the same second (confirmed live:
# they did, before this limiter existed). GROQ_REASONING_EFFORT=low keeps
# gpt-oss's hidden reasoning tokens from eating the tight TPM budget (only
# sent when GROQ_MODEL contains "gpt-oss" — Llama models reject the param).
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_COMPLETION_TOKENS=3500
GROQ_TPM_LIMIT=8000
GROQ_RPM_LIMIT=28
GROQ_REASONING_EFFORT=low
GROQ_TOOL_RESULT_MAX_CHARS=1800

# Multi-agent mode (/generate-pain-point-md-multiagent): parallel per-topic
# research agents + one synthesis/writer agent, each independently
# configurable. Any request can override these per-call (see
# schemas.requests.GenerateMdDocRequestMultiAgent); these are just the
# server-side defaults. groq (openai/gpt-oss-120b) is set for both roles
# here for speed; ollama remains the only option with no external rate
# limit of any kind (nothing leaves this machine) if groq's free-tier
# budget turns out too tight for your usage — no API key, no signup, no
# payment method either way. gemma and cerebras were removed (2026-08-06):
# gemma kept tripping its free-tier rate limits under 8-way parallel load,
# cerebras' "free" plan requires a payment method at signup. Falls back to
# that provider's own *_MODEL var when the model override is left blank.
RESEARCH_AGENT_PROVIDER=ollama
#RESEARCH_AGENT_MODEL=
SYNTHESIS_AGENT_PROVIDER=ollama
#SYNTHESIS_AGENT_MODEL=

# On Render (see render.yaml), these two are overridden to "groq" via real
# process env vars — python-dotenv's load_dotenv() never overrides a
# variable that's already set in the environment, so the "ollama" default
# above only applies locally, where Ollama is actually reachable.

# Storage bucket name for persisted reports (services/storage_service.py).
# Only used when SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY (secrets, in .env)
# are set — see supabase/schema.sql and README.md "Deploy: prodotto per il team".
SUPABASE_BUCKET=reports

# Used only when a role's provider is azure. AZURE_OPENAI_API_KEY (secret)
# lives in .env. AZURE_OPENAI_ENDPOINT is the "Azure OpenAI endpoint" from the
# Azure AI Foundry resource page (https://<resource>.openai.azure.com/), NOT
# the "Project endpoint" (services.ai.azure.com) — see providers/azure_provider.py.
AZURE_OPENAI_ENDPOINT=https://rosalinda-5478-resource.services.ai.azure.com/openai/v1
# The deployment name you created in Azure AI Foundry (not the base model name).
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
# Check the Azure OpenAI docs for the current stable API version.
#AZURE_OPENAI_API_VERSION=2026-03-05
