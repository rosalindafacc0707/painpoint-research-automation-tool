MODEL_NAME=claude-sonnet-5
PROMPT_VERSION=v6
#v6 is perfect for provider like ollama and azure and gemini
MAX_TOKENS=12000

# Provider switch: "anthropic" (default), "azure", "gemini", "gemma", "ollama", or "groq"
PROVIDER=ollama

# Used only when PROVIDER=gemini. GEMINI_API_KEY (secret) lives in .env.
GEMINI_MODEL=gemini-3.6-flash
#gemini-2.5-pro

# Used only when PROVIDER=gemma. It reuses GEMINI_API_KEY unless GEMMA_API_KEY
# is set in .env.
GEMMA_MODEL=gemma-4-26b-a4b-it

# Used only when PROVIDER=ollama. No API key is needed: Ollama runs locally.
# qwen3.5:9b is the recommended local model for this 16 GB MacBook Air.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
#qwen3.5:9b
#deepseek-r1:1.5b
OLLAMA_NUM_CTX=32768
OLLAMA_TEMPERATURE=0.2

# Used only when PROVIDER=groq. GROQ_API_KEY (secret) lives in .env.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
# Fits a Groq on-demand account with an 8k TPM allowance; increase these only
# after upgrading the Groq tier.
GROQ_MAX_COMPLETION_TOKENS=3500
GROQ_TPM_LIMIT=8000
GROQ_TOOL_RESULT_MAX_CHARS=1800

# Used only when PROVIDER=azure. AZURE_OPENAI_API_KEY (secret) lives in .env.
# AZURE_OPENAI_ENDPOINT is the "Azure OpenAI endpoint" from the Azure AI
# Foundry resource page (https://<resource>.openai.azure.com/), NOT the
# "Project endpoint" (services.ai.azure.com) — see providers/azure_provider.py.
AZURE_OPENAI_ENDPOINT=https://rosalinda-5478-resource.services.ai.azure.com/openai/v1
# The deployment name you created in Azure AI Foundry (not the base model name).
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
# Check the Azure OpenAI docs for the current stable API version.
#AZURE_OPENAI_API_VERSION=2026-03-05
