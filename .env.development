PROMPT_VERSION=v7
MAX_TOKENS=12000

# Provider switch: "mistral" (default), "azure", "gemini", or "ollama"
PROVIDER=mistral

# Used only when PROVIDER=gemini. GEMINI_API_KEY (secret) lives in .env.
GEMINI_MODEL=gemini-3.6-flash
#gemini-2.5-pro


# Used only when PROVIDER=ollama. No API key is needed: Ollama runs locally.
# qwen3.5:9b is the recommended local model for this 16 GB MacBook Air.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
#qwen3.5:9b
#deepseek-r1:1.5b
OLLAMA_NUM_CTX=32768
OLLAMA_TEMPERATURE=0.2

# Used only when PROVIDER=mistral. MISTRAL_API_KEY (secret) lives in .env.
# Two phases, two models — see providers/mistral_provider.py for why
# (La Plateforme's per-model rate limits differ by ~2 orders of magnitude).
MISTRAL_RESEARCH_MODEL=ministral-8b-2512
MISTRAL_SYNTHESIS_MODEL=mistral-large-2512
MISTRAL_MAX_RETRIES=5
MISTRAL_RETRY_BASE_SECONDS=2

# Used only when PROVIDER=azure. AZURE_OPENAI_API_KEY (secret) lives in .env.
# AZURE_OPENAI_ENDPOINT is the "Azure OpenAI endpoint" from the Azure AI
# Foundry resource page (https://<resource>.openai.azure.com/), NOT the
# "Project endpoint" (services.ai.azure.com) — see providers/azure_provider.py.
AZURE_OPENAI_ENDPOINT=https://rosalinda-5478-resource.services.ai.azure.com/openai/v1
# The deployment name you created in Azure AI Foundry (not the base model name).
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
